# .env — OVERRIDES AND SECRETS ONLY (gitignored).
#
# The committed source of truth for non-secret config is nemoclaw-rag.toml.
# Anything set here overrides that file. Leave a line out to use the TOML value.
# Full registry: docs/CONFIGURATION.md
#
# Copy this file:  cp .env.example .env

# ---- Secrets (never commit) -------------------------------------------------
OPENAI_API_KEY=

# ---- Model overrides (optional) --------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TEMPERATURE=0
# OPENAI_TIMEOUT_SECONDS=60

# ---- MongoDB overrides (optional) ------------------------------------------
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=nemoclaw_rag
# MONGODB_COLLECTION=chunks
# MONGODB_SMOKE_DB=nemoclaw_rag_smoke
# MONGODB_SMOKE_COLLECTION=chunks
# Compose reads MONGODB_IMAGE / MONGODB_PORT from this file:
# MONGODB_IMAGE=mongo:7
# MONGODB_PORT=27017

# ---- RAG overrides (optional) ----------------------------------------------
# RAG_CORPUS_DIR=corpus
# RAG_TOP_K=3
# RAG_CHUNK_MAX_CHARS=900
# RAG_CHUNK_OVERLAP=120

# ---- Agent / sandbox overrides (optional) ----------------------------------
# NEMOCLAW_AGENT=hermes
# NEMOCLAW_SANDBOX_NAME=nemoclaw-rag-base
# NEMOCLAW_PROVIDER=openai-api
